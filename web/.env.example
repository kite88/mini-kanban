# =============================================================
# 前端环境变量模板
# 使用方式：复制为 .env.local 后修改（修改后需重启 npm run dev）
#   cp .env.example .env.local        # Linux / macOS
#   Copy-Item .env.example .env.local # PowerShell
# .env.local 已被 .gitignore 忽略，不会提交到仓库
# =============================================================
# 后端接口地址，端口需与 server/config.yaml 的 server.port 一致
NEXT_PUBLIC_API_BASE=http://localhost:8281/api
