# =============================================================
# docker compose 变量模板（.env.example.docker-compose）
#
# 别和 web/.env.example 搞混：
#   - 本文件        docker compose 部署用，复制为仓库根目录的 .env
#   - web/.env.example  Next.js 本地开发用，复制为 web/.env.local
#
# 使用方式：
#   cp .env.example.docker-compose .env          # Linux / macOS
#   Copy-Item .env.example.docker-compose .env   # PowerShell
#
# 注意：最终文件名必须叫 .env（docker compose 默认读的就是它），不要改名。
#
# 该文件只被 docker compose 用于变量替换，不会被打进任何镜像。
# 带 :? 的变量缺失时 compose 会直接报错，避免用默认弱口令跑起来。
# =============================================================

# ---------- 对外访问 ----------
# 宿主机映射端口（容器内 nginx 固定监听 80）。
# 注意别和本机已在跑的服务冲突（例如本地 go run . 占用的 8281）
HTTP_PORT=8080
TZ=Asia/Shanghai

# ---------- PostgreSQL ----------
POSTGRES_DB=mini-kanban
POSTGRES_USER=mini-kanban
# 必填，务必改掉
POSTGRES_PASSWORD=change-me-db-password

# ---------- Redis ----------
# 必填，务必改掉
REDIS_PASSWORD=change-me-redis-password

# ---------- JWT ----------
# 必填。换成足够随机的长字符串（例如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string

# ---------- 初始管理员 ----------
# 仅在首次启动、用户表为空时写入；写入成功后后端会自动清空配置里的 seed 段，
# 建议创建完就改回 false 再重启一次
SEED_ENABLED=false
# 临时置 true 可强制重置 / 重建该管理员（忽略「用户表为空」的前提，仅本次启动生效）。
# 一般不用手动改：执行 bash deploy/deploy.sh --reset-admin 会自动设置并在启动后改回。
SEED_FORCE_RESET=false
SEED_ADMIN_EMAIL=admin@mail.example.com
SEED_ADMIN_USERNAME=Admin
SEED_ADMIN_PASSWORD=change-me-admin-password

# ---------- 前端接口地址（构建期内联）----------
# 同源反代保持 /api 即可；前后端分域时填完整地址，例如 https://api.example.com/api
# 改完必须重新构建前端镜像：docker compose up -d --build web
NEXT_PUBLIC_API_BASE=/api

# ---------- 附件 ----------
# 单个附件上限（MB）；后端请求体上限 = 本值 × 10，
# 需要同步调整 deploy/nginx.conf 里的 client_max_body_size
STORAGE_MAX_SIZE_MB=10
